# این فایل را کپی کنید: cp .env.example .env  و مقادیر را پر کنید
BOT_TOKEN=
# آدرس عمومی HTTPS که index.html و API همین برنامه را ارائه می‌کند
WEBAPP_URL=https://your-domain.com
# شناسه عددی ادمین‌ها، جداشده با کاما
ADMINS=123456789,987654321
REQUIRED_CHATS=@bk_chatt,@_burnt_kingdoms
ANNOUNCE_CHANNEL=@_burnt_kingdoms
PORT=8080
# مسیر دیتابیس قبلی را تغییر ندهید تا داده‌های فعلی حفظ شود
DB_PATH=bk.db
